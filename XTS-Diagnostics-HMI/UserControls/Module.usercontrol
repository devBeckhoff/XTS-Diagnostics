<div id="Module" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-height="100" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-creator-viewport-width="960" data-tchmi-creator-viewport-height="1080">


<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "background-container"
]
</script>
<div id="ModuleHeader" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="8" data-tchmi-height-unit="%" data-tchmi-left="38" data-tchmi-left-unit="%" data-tchmi-text="Module Info" data-tchmi-top="4" data-tchmi-top-unit="%" data-tchmi-word-wrap="True" data-tchmi-right="38" data-tchmi-right-unit="%" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Bottom" data-tchmi-text-font-size="%f%0.5*%ctrl%ModuleHeader::RenderedHeight%/ctrl%%/f%">


<script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
{
  "left": 0,
  "right": 0,
  "top": 0,
  "bottom": 1,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>

<script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
{
  "left": "None",
  "right": "None",
  "top": "None",
  "bottom": "Solid"
}
</script>
</div>
<div id="AmplifierI2T" data-tchmi-type="TcHmi.Controls.TcHmiExtendedControls.LabeledNumericInput" data-tchmi-auto-focus-out="True" data-tchmi-decimal-digits="0" data-tchmi-height="5" data-tchmi-height-unit="%" data-tchmi-label-word-wrap="True" data-tchmi-left="8" data-tchmi-left-unit="%" data-tchmi-reset-to-last-valid-value="True" data-tchmi-top="36" data-tchmi-top-unit="%" data-tchmi-is-read-only="True" data-tchmi-right-unit="%" data-tchmi-right="8" data-tchmi-label="Coil Temperature" data-tchmi-unit="C" data-tchmi-label-to-input-ratio="1:1" data-tchmi-value-horizontal-alignment="Center" data-tchmi-label-horizontal-alignment="Center" data-tchmi-label-vertical-alignment="Center" data-tchmi-unit-vertical-alignment="Center" data-tchmi-unit-font-size="%f%0.80*%ctrl%AmplifierI2T::RenderedHeight%/ctrl%%/f%" data-tchmi-value-font-size="%f%0.80*%ctrl%AmplifierI2T::RenderedHeight%/ctrl%%/f%" data-tchmi-unit-position="Right" data-tchmi-value="%f%(%pp%AmplifierI2T%/pp%[0] +\n%pp%AmplifierI2T%/pp%[1] +\n%pp%AmplifierI2T%/pp%[2] +\n%pp%AmplifierI2T%/pp%[3] +\n%pp%AmplifierI2T%/pp%[4] +\n%pp%AmplifierI2T%/pp%[5] +\n%pp%AmplifierI2T%/pp%[6] +\n%pp%AmplifierI2T%/pp%[7] +\n%pp%AmplifierI2T%/pp%[8] +\n%pp%AmplifierI2T%/pp%[9] +\n%pp%AmplifierI2T%/pp%[10] +\n%pp%AmplifierI2T%/pp%[11] +\n%pp%AmplifierI2T%/pp%[12] +\n%pp%AmplifierI2T%/pp%[13] +\n%pp%AmplifierI2T%/pp%[14])/15%/f%" data-tchmi-label-font-size="%f%0.80*%ctrl%AmplifierI2T::RenderedHeight%/ctrl%%/f%">
